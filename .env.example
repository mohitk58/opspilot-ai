# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_URL=amqp://opspilot:opspilot@localhost:5672

# ── Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=7d

# ── App ─────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Logging ─────────────────────────────────────────────────
# Optional — omit to default to "info" when NODE_ENV=production, "debug" otherwise
# LOG_LEVEL=debug
